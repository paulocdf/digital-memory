rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notes/{noteId} {
      // Users can read their own notes OR notes shared with them
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || request.auth.uid in resource.data.collaborators);

      // Users can only create notes assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'content'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 500000;

      // Owner can update anything; collaborators can update note fields;
      // invitee can add self to collaborators after accepting a share
      allow update: if request.auth != null
                    && (
                      // Owner: full update access, userId must stay unchanged
                      (resource.data.userId == request.auth.uid
                       && request.resource.data.userId == request.auth.uid)
                      ||
                      // Collaborator: can update note fields but not ownership or sharing
                      (resource.data.collaborators is list
                       && request.auth.uid in resource.data.collaborators
                       && request.resource.data.userId == resource.data.userId
                       && request.resource.data.collaborators == resource.data.collaborators)
                      ||
                      // Invitee self-adding to collaborators after accepting a share:
                      // Verify an accepted noteShares doc exists with deterministic ID (noteId_inviteeUid).
                      (request.resource.data.userId == resource.data.userId
                       && request.auth.uid in request.resource.data.collaborators
                       && exists(/databases/$(database)/documents/noteShares/$(noteId + '_' + request.auth.uid))
                       && get(/databases/$(database)/documents/noteShares/$(noteId + '_' + request.auth.uid)).data.status == 'accepted'
                       && get(/databases/$(database)/documents/noteShares/$(noteId + '_' + request.auth.uid)).data.inviteeUid == request.auth.uid
                       && (
                         // Case A: collaborators field exists — ensure only one uid is added, none removed
                         (resource.data.collaborators is list
                          && !(request.auth.uid in resource.data.collaborators)
                          && request.resource.data.collaborators.hasAll(resource.data.collaborators)
                          && request.resource.data.collaborators.size() == resource.data.collaborators.size() + 1)
                         ||
                         // Case B: collaborators field is missing/null — new array must be exactly [inviteeUid]
                         (!(resource.data.collaborators is list)
                          && request.resource.data.collaborators.size() == 1)
                       ))
                    );

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /noteVersions/{versionId} {
      // Users can only read their own versions
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create versions assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'noteId', 'content'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 500000;

      // No updates — versions are immutable snapshots
      allow update: if false;

      // Users can only delete their own versions
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /attachments/{attachmentId} {
      // Users can only read their own attachments
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create attachments assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'noteId', 'fileName', 'storagePath'])
                    && request.resource.data.fileName is string
                    && request.resource.data.fileName.size() <= 500;

      // No updates — attachments are immutable metadata
      allow update: if false;

      // Users can only delete their own attachments
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /reviewCards/{cardId} {
      // Users can only read their own review cards
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create review cards assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId']);

      // Users can only update their own review cards; userId must stay unchanged
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // Users can only delete their own review cards
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /kanbanColumns/{columnId} {
      // Users can only read their own kanban columns
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create kanban columns assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'name', 'status', 'order'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200;

      // Users can only update their own kanban columns; userId must stay unchanged
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // Users can only delete their own kanban columns
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /projects/{projectId} {
      // Users can read their own projects OR projects shared with them
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || request.auth.uid in resource.data.collaborators);

      // Users can only create projects assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200;

      // Owner can update anything; collaborators can update project fields;
      // invitee can add self to collaborators after accepting a share
      allow update: if request.auth != null
                    && (
                      // Owner: full update access, userId must stay unchanged
                      (resource.data.userId == request.auth.uid
                       && request.resource.data.userId == request.auth.uid)
                      ||
                      // Collaborator: can update project fields but not ownership or sharing
                      (resource.data.collaborators is list
                       && request.auth.uid in resource.data.collaborators
                       && request.resource.data.userId == resource.data.userId
                       && request.resource.data.collaborators == resource.data.collaborators)
                      ||
                      // Invitee self-adding to collaborators after accepting a share:
                      // Verify an accepted projectShares doc exists with deterministic ID (projectId_inviteeUid).
                      (request.resource.data.userId == resource.data.userId
                       && request.auth.uid in request.resource.data.collaborators
                       && exists(/databases/$(database)/documents/projectShares/$(projectId + '_' + request.auth.uid))
                       && get(/databases/$(database)/documents/projectShares/$(projectId + '_' + request.auth.uid)).data.status == 'accepted'
                       && get(/databases/$(database)/documents/projectShares/$(projectId + '_' + request.auth.uid)).data.inviteeUid == request.auth.uid
                       && (
                         // Case A: collaborators field exists — ensure only one uid is added, none removed
                         (resource.data.collaborators is list
                          && !(request.auth.uid in resource.data.collaborators)
                          && request.resource.data.collaborators.hasAll(resource.data.collaborators)
                          && request.resource.data.collaborators.size() == resource.data.collaborators.size() + 1)
                         ||
                         // Case B: collaborators field is missing/null — new array must be exactly [inviteeUid]
                         (!(resource.data.collaborators is list)
                          && request.resource.data.collaborators.size() == 1)
                       ))
                    );

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /todos/{todoId} {
      // Users can read their own todos OR todos shared with them
      // Note: no "collaborators is list" guard here — Firestore query-based
      // rule evaluation needs the rule to match the query constraints directly.
      // An array-contains query already implies the field is an array.
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || request.auth.uid in resource.data.collaborators);

      // Users can only create todos assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'title'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 500;

      // Owner can update anything; collaborators can update task fields;
      // invitee can add self to collaborators after accepting a share
      allow update: if request.auth != null
                    && (
                      // Owner: full update access, userId must stay unchanged
                      (resource.data.userId == request.auth.uid
                       && request.resource.data.userId == request.auth.uid)
                      ||
                      // Collaborator: can update task fields but not ownership or sharing
                      (resource.data.collaborators is list
                       && request.auth.uid in resource.data.collaborators
                       && request.resource.data.userId == resource.data.userId
                       && request.resource.data.collaborators == resource.data.collaborators)
                      ||
                      // Invitee self-adding to collaborators after accepting a share:
                      // Verify an accepted taskShares doc exists with deterministic ID (todoId_inviteeUid).
                      // Handles both cases: collaborators field exists as list, or is missing/null.
                      (request.resource.data.userId == resource.data.userId
                       && request.auth.uid in request.resource.data.collaborators
                       && exists(/databases/$(database)/documents/taskShares/$(todoId + '_' + request.auth.uid))
                       && get(/databases/$(database)/documents/taskShares/$(todoId + '_' + request.auth.uid)).data.status == 'accepted'
                       && get(/databases/$(database)/documents/taskShares/$(todoId + '_' + request.auth.uid)).data.inviteeUid == request.auth.uid
                       && (
                         // Case A: collaborators field exists — ensure only one uid is added, none removed
                         (resource.data.collaborators is list
                          && !(request.auth.uid in resource.data.collaborators)
                          && request.resource.data.collaborators.hasAll(resource.data.collaborators)
                          && request.resource.data.collaborators.size() == resource.data.collaborators.size() + 1)
                         ||
                         // Case B: collaborators field is missing/null — new array must be exactly [inviteeUid]
                         (!(resource.data.collaborators is list)
                          && request.resource.data.collaborators.size() == 1)
                       ))
                    );

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /taskShares/{shareId} {
      // Owner and invitees can read
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.inviteeEmail == request.auth.token.email);

      // Only authenticated users can create, and they must be the owner
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['ownerId', 'todoId', 'inviteeEmail', 'status']);

      // Owner can update anything; invitee can only update status (accept/decline)
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || (resource.data.inviteeEmail == request.auth.token.email
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteeUid', 'updatedAt'])));

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /noteShares/{shareId} {
      // Owner and invitees can read
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.inviteeEmail == request.auth.token.email);

      // Only authenticated users can create, and they must be the owner
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['ownerId', 'noteId', 'inviteeEmail', 'status']);

      // Owner can update anything; invitee can only update status (accept/decline)
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || (resource.data.inviteeEmail == request.auth.token.email
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteeUid', 'updatedAt'])));

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /projectShares/{shareId} {
      // Owner and invitees can read
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.inviteeEmail == request.auth.token.email);

      // Only authenticated users can create, and they must be the owner
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['ownerId', 'projectId', 'inviteeEmail', 'status']);

      // Owner can update anything; invitee can only update status (accept/decline)
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || (resource.data.inviteeEmail == request.auth.token.email
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteeUid', 'updatedAt'])));

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      // Any authenticated user can look up other users (for sharing by email)
      allow read: if request.auth != null;

      // Users can only create/update their own profile
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;

      // Users cannot delete profiles
      allow delete: if false;
    }

    match /timerState/{userId} {
      // Users can only read/write their own timer state document
      // Document ID is the user's UID
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /userSettings/{userId} {
      // Users can only read/write their own settings (closedDays, etc.)
      // Document ID is the user's UID
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /pomodoroProgress/{userId} {
      // Users can only read/write their own pomodoro progress
      // Document ID is the user's UID
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ─── Budget / Finance (v17) ───
    // Private, per-user financial data. No sharing. Users can opt out of
    // cloud sync entirely via "local-only" mode (handled client-side).

    match /accounts/{accountId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /budgets/{budgetId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'month', 'categoryId'])
                    && request.resource.data.month is string;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'accountId', 'amount', 'date'])
                    && request.resource.data.amount is number
                    && request.resource.data.date is string;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /recurring/{recurringId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'name', 'frequency'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Spreadsheet workspace (Phase F1 foundation). Per-user isolation only —
    // sharing is not yet supported. cellsJson is a JSON-stringified blob; we
    // cap its size here to prevent runaway documents (Firestore's hard limit
    // is 1 MiB per doc; we keep well below it).
    match /sheets/{sheetId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'title'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && (!('cellsJson' in request.resource.data)
                        || (request.resource.data.cellsJson is string
                            && request.resource.data.cellsJson.size() <= 500000));
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && (!('cellsJson' in request.resource.data)
                        || (request.resource.data.cellsJson is string
                            && request.resource.data.cellsJson.size() <= 500000));
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Auto-categorization rules (Phase 3 Slice F). Per-user isolation only.
    // Soft-deleted via `deletedAt` field; reads still allowed for owner.
    match /categoryRules/{ruleId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'matchType', 'pattern', 'categoryId'])
                    && request.resource.data.matchType is string
                    && request.resource.data.pattern is string
                    && request.resource.data.pattern.size() <= 500;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && (!('pattern' in request.resource.data)
                        || (request.resource.data.pattern is string
                            && request.resource.data.pattern.size() <= 500));
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Note sections (v21). Per-user isolation. Configurable rename of the four
    // built-in sections (inbox/topic/book-note/snippets) plus user-defined
    // flat sections referenced by notes via destination = 'section:<id>'.
    // Soft-deleted via `deletedAt`; reads still allowed for owner.
    match /noteSections/{sectionId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'name', 'slug'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.slug is string
                    && request.resource.data.slug.size() <= 200;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && (!('name' in request.resource.data)
                        || (request.resource.data.name is string
                            && request.resource.data.name.size() <= 200))
                    && (!('slug' in request.resource.data)
                        || (request.resource.data.slug is string
                            && request.resource.data.slug.size() <= 200));
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
