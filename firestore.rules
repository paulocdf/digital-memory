rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notes/{noteId} {
      // Users can only read their own notes
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create notes assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'content'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 500000;

      // Users can only update their own notes; userId must stay unchanged
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // Users can only delete their own notes
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /noteVersions/{versionId} {
      // Users can only read their own versions
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create versions assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'noteId', 'content'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 500000;

      // No updates — versions are immutable snapshots
      allow update: if false;

      // Users can only delete their own versions
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /attachments/{attachmentId} {
      // Users can only read their own attachments
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create attachments assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'noteId', 'fileName', 'storagePath'])
                    && request.resource.data.fileName is string
                    && request.resource.data.fileName.size() <= 500;

      // No updates — attachments are immutable metadata
      allow update: if false;

      // Users can only delete their own attachments
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /reviewCards/{cardId} {
      // Users can only read their own review cards
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Users can only create review cards assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'noteId']);

      // Users can only update their own review cards; userId must stay unchanged
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // Users can only delete their own review cards
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /todos/{todoId} {
      // Users can read their own todos OR todos shared with them
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || (resource.data.collaborators is list
                          && request.auth.uid in resource.data.collaborators));

      // Users can only create todos assigned to themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'title'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 500;

      // Owner can update anything; collaborators can update but not change userId or collaborators
      allow update: if request.auth != null
                    && (
                      // Owner: full update access, userId must stay unchanged
                      (resource.data.userId == request.auth.uid
                       && request.resource.data.userId == request.auth.uid)
                      ||
                      // Collaborator: can update task fields but not ownership or sharing
                      (resource.data.collaborators is list
                       && request.auth.uid in resource.data.collaborators
                       && request.resource.data.userId == resource.data.userId
                       && request.resource.data.collaborators == resource.data.collaborators)
                    );

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /taskShares/{shareId} {
      // Owner and invitees can read
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.inviteeEmail == request.auth.token.email);

      // Only authenticated users can create, and they must be the owner
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasAll(['ownerId', 'todoId', 'inviteeEmail', 'status']);

      // Owner can update anything; invitee can only update status (accept/decline)
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || (resource.data.inviteeEmail == request.auth.token.email
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteeUid', 'updatedAt'])));

      // Only owner can delete
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      // Any authenticated user can look up other users (for sharing by email)
      allow read: if request.auth != null;

      // Users can only create/update their own profile
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;

      // Users cannot delete profiles
      allow delete: if false;
    }

    match /timerState/{userId} {
      // Users can only read/write their own timer state document
      // Document ID is the user's UID
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /userSettings/{userId} {
      // Users can only read/write their own settings (closedDays, etc.)
      // Document ID is the user's UID
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /pomodoroProgress/{userId} {
      // Users can only read/write their own pomodoro progress
      // Document ID is the user's UID
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
